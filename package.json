{
  "name": "coinswag",
  "version": "1.0.0",
  "private": true,
  "description": "Automated Multi-Chain Crypto Swap Engine with Monero Zero-Knowledge Privacy Hub",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@coinswag/core && npm run build --workspace=@coinswag/blockchain && npm run build --workspace=@coinswag/liquidity && npm run build --workspace=@coinswag/api && npm run build --workspace=@coinswag/bot && npm run build --workspace=@coinswag/web",
    "test": "node scripts/test-all.cjs",
    "test:all": "node scripts/test-all.cjs",
    "test:core": "node packages/core/dist/test-suite.js",
    "test:split": "node packages/core/dist/test-split.js && node apps/api/dist/test-split-api.js",
    "test:lightning": "node packages/blockchain/dist/test-lightning.js",
    "test:failover": "node packages/blockchain/dist/test-failover.js",
    "test:tor": "node packages/blockchain/dist/test-tor.js",
    "test:bot": "node apps/bot/dist/test-bot.js",
    "test:mempool": "node packages/blockchain/dist/test-mempool.js",
    "test:sweeper": "node packages/liquidity/dist/test-fee-sweeper.js",
    "test:thorchain": "node packages/liquidity/dist/test-thorchain.js",
    "test:api": "node apps/api/dist/test-api.js",
    "test:security": "node packages/core/dist/test-security.js && node apps/api/dist/test-security-suite.js",

    "start:bot": "node apps/bot/dist/index.js",
    "prod:start": "npx pm2 start ecosystem.config.cjs",
    "prod:stop": "npx pm2 stop ecosystem.config.cjs",
    "prod:status": "npx pm2 status",
    "prod:logs": "npx pm2 logs",

    "start": "node apps/api/dist/index.js",
    "dev:api": "node apps/api/dist/index.js",
    "dev:web": "npm run dev --workspace=@coinswag/web"

  },
  "keywords": [
    "crypto",
    "swap",
    "monero",
    "privacy",
    "no-kyc",
    "cross-chain",
    "bitcoin",
    "ethereum",
    "solana"
  ],
  "author": "CoinSwag Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
