# ==============================================================================
# CoinSwag: Automated Zero-KYC Multi-Chain Swap Hub - External Node Configuration
# ==============================================================================

# Server Port
PORT=3001

# ------------------------------------------------------------------------------
# 1. MONERO (XMR) ZERO-KNOWLEDGE HUB
# ------------------------------------------------------------------------------
# Trusted public remote nodes for Monero. 
# You DO NOT need to run a local 150GB+ monerod blockchain node!
# CoinSwag's lightweight monero-wallet-rpc connects directly to any of these remote daemons.
XMR_REMOTE_NODES=https://node.community.rino.io:18081,https://nodes.hashvault.pro:18081,https://xmr-node.cakewallet.com:18081,https://node.moneroworld.com:18089

# Local monero-wallet-rpc endpoint (if running locally against remote daemons)
XMR_WALLET_RPC_URL=http://127.0.0.1:18083

# Optional: Route all external Monero remote node calls over Tor for maximum IP privacy
XMR_USE_TOR=false

# ------------------------------------------------------------------------------
# 2. BITCOIN (BTC) EXTERNAL NODES
# ------------------------------------------------------------------------------
# Comma-separated list of external Mempool.space / Blockstream / QuickNode endpoints
BTC_RPC_URLS=https://mempool.space/api,https://blockstream.info/api

# ------------------------------------------------------------------------------
# 3. ETHEREUM (ETH & ERC-20 TOKENS)
# ------------------------------------------------------------------------------
# External EVM RPC endpoints with automatic failover (Alchemy, Infura, or free public RPCs)
ETH_RPC_URLS=https://eth.llamarpc.com,https://rpc.ankr.com/eth,https://cloudflare-eth.com

# ------------------------------------------------------------------------------
# 4. SOLANA (SOL & SPL TOKENS)
# ------------------------------------------------------------------------------
# External Solana RPC endpoints (Helius, QuickNode, Triton, or public mainnet)
SOL_RPC_URLS=https://api.mainnet-beta.solana.com,https://solana-mainnet.rpc.extrnode.com

# ------------------------------------------------------------------------------
# 5. BNB SMART CHAIN (BSC / BEP-20)
# ------------------------------------------------------------------------------
BSC_RPC_URLS=https://binance.llamarpc.com,https://bsc-dataseed.binance.org

# ------------------------------------------------------------------------------
# 6. OTHER SUPPORTED CHAINS (LTC, DOGE, TRON, XRP)
# ------------------------------------------------------------------------------
LTC_RPC_URLS=https://litecoinspace.org/api
DOGE_RPC_URLS=https://dogechain.info/api/v1
TRON_RPC_URLS=https://api.trongrid.io
XRP_RPC_URLS=https://s1.ripple.com:51234

# ==============================================================================
# 7. OPERATOR REVENUE: EXTERNAL FEE RECIPIENT WALLETS
# ==============================================================================
# All platform swap fees (0.45% / 0.75%) automatically route to these addresses:
FEE_RECIPIENT_XMR=888tNkZrPN6JsEgekjMnABU4TBzc2Dt29EPAvkFxbANsAnJYPbb3iQ1YBRk1UXCDRSiKc9dhwMVgN5S9cQUiyoogDavup3H
FEE_RECIPIENT_BTC=bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq
FEE_RECIPIENT_EVM=0x742d35Cc6634C0532925a3b844Bc454e4438f44e
FEE_RECIPIENT_SOL=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM

# Sweeper mode: 'REALTIME' (sweeps every swap) or 'BATCH' (accumulates to save gas)
FEE_SWEEP_MODE=REALTIME
# For BATCH mode: minimum USD value before auto-sweeping to external wallet
FEE_SWEEP_THRESHOLD_USD=50.0

