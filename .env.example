# ==============================================================================
# CoinSwag - Operator Environment Configuration (.env)
# 
# KEEP THIS FILE SECURE AND NEVER COMMIT IT TO GIT.
# This file stores your operator payout addresses, RPC credentials, and keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operator Fee Recipient Wallets (Where Platform Revenue Is Swept)
# ------------------------------------------------------------------------------
# All swap service fees and address splitting fees are automatically swept here:
FEE_RECIPIENT_BTC=bc1qar0srrr7xfkvy5l643lydnw9re59gtzzwf5mdq
FEE_RECIPIENT_XMR=888tNkZrPN6JsEgekjMnABU4TBzc2Dt29EPAvkFxbANsAnJYPbb3iQ1YBRk1UXCDRSiKc9dhwMVgN5S9cQUiyoogDavup3H
FEE_RECIPIENT_EVM=0x742d35Cc6634C0532925a3b844Bc454e4438f44e
FEE_RECIPIENT_SOL=9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM

# Fee Sweep Mode: 'REALTIME' (sweeps immediately on each trade) or 'BATCH' (accumulates)
FEE_SWEEP_MODE=REALTIME
# If BATCH mode is used, minimum USD threshold to trigger on-chain sweep
FEE_SWEEP_THRESHOLD_USD=50.0

# ------------------------------------------------------------------------------
# 2. Server Ports & Networking
# ------------------------------------------------------------------------------
PORT=5173
API_PORT=3001
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. Monero Privacy Hub Remote Nodes & RPC Gateway
# ------------------------------------------------------------------------------
# Comma-separated list of remote Monero nodes (failover automatically rotates)
XMR_REMOTE_NODES=https://node.community.rino.io:18081,https://nodes.hashvault.pro:18081,https://xmr-node.cakewallet.com:18081
# Set to 'true' to route all Monero RPC requests over the local Tor SOCKS5 proxy
XMR_USE_TOR=false
TOR_SOCKS_PORT=9050

# ------------------------------------------------------------------------------
# 4. Telegram Bot Integration (Optional)
# ------------------------------------------------------------------------------
# If running the CoinSwag Telegram Mini App / Bot, provide token from @BotFather:
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------------------------
# 5. Financial Sentinel & Hot-Wallet Circuit Breaker
# ------------------------------------------------------------------------------
# Maximum single outflow in USD before emergency halt
MAX_SINGLE_PAYOUT_USD=50000
# Maximum rolling 10-minute cumulative outflow before emergency halt
MAX_VELOCITY_WINDOW_USD=100000
